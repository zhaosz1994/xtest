# ==================== Docker 部署环境变量配置 ====================
# 使用方法: 复制此文件为 .env.docker 并修改配置值
# 启动命令: docker-compose --env-file .env.docker up -d

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=your_root_password_here
DB_NAME=xtest_db
DB_USER=xtest_user
DB_PASSWORD=your_secure_password_here
MYSQL_PORT=3306

# ==================== 应用配置 ====================
PORT=3000
NODE_ENV=production

# JWT 密钥 (请使用强随机字符串)
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# CORS 允许的域名 (多个域名用逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://your-domain.com

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_CONSOLE=true

# ==================== 时区配置 ====================
TZ=Asia/Shanghai
