# ==================== Docker 离线部署环境变量配置 ====================
# 使用方法: 复制此文件为 .env 并修改配置值
# 启动命令: ./start.sh

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=xtest_root_2024
DB_NAME=xtest_db
DB_USER=xtest_user
DB_PASSWORD=xtest_pass_2024
MYSQL_PORT=3306

# ==================== 应用配置 ====================
# 应用端口已固定为 8000
NODE_ENV=production

# JWT 密钥 (请使用强随机字符串)
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=please_change_this_to_a_random_secret_key

# CORS 允许的域名 (多个域名用逗号分隔)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_CONSOLE=true

# ==================== 时区配置 ====================
TZ=Asia/Shanghai
